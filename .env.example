# Copie este arquivo para .env (uso local) e preencha os valores reais.
# Em produção (Vercel), essas mesmas variáveis são definidas no painel do
# projeto, em Settings -> Environment Variables -- nunca em um arquivo.

# Connection string do Postgres. Em produção, use a "Transaction pooler"
# connection string do Supabase (Project Settings -> Database -> Connection
# string -> Transaction). Localmente, aponta para um Postgres na sua máquina.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estoque_wap

# Não há tela de login neste projeto (o link já dá acesso completo a
# qualquer pessoa), então esta variável não tem efeito prático hoje -- só
# seria usada se um login for reintroduzido no futuro.
JWT_SECRET=

# Opcionais: só usadas por "npm run seed", que pré-cadastra uma linha de
# usuário ADM na tabela de usuários (útil apenas como registro/anotação,
# já que a tela "Usuários" não restringe mais nada).
SEED_ADMIN_USERNAME=leandro
SEED_ADMIN_NAME=Leandro Genoveski
SEED_ADMIN_PASSWORD=
